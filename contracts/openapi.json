{
  "openapi": "3.1.0",
  "info": {
    "title": "Lazulite Studio API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Available capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created project",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectSummary" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/assets": {
      "post": {
        "operationId": "uploadAsset",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded asset",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Project summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects/{projectId}/jobs": {
      "get": {
        "operationId": "listJobs",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createJob",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobCreate" } } }
        },
        "responses": {
          "202": { "description": "Queued job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
          "409": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/jobs/{kind}": {
      "post": {
        "operationId": "createTypedJob",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "name": "kind", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobParams" } } } },
        "responses": { "202": { "description": "Queued job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getJob",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "description": "Job snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "description": "Cancellation state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/result": {
      "get": {
        "operationId": "getJobResult",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": { "200": { "description": "Job result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobResult" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/jobs/{jobId}/events": {
      "get": {
        "operationId": "streamJobEvents",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }, { "name": "after_seq", "in": "query", "schema": { "type": "integer", "minimum": 0 } }],
        "responses": { "200": { "description": "Server sent events", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/projects/{projectId}/document": {
      "get": {
        "operationId": "getDocument",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Rich TTML document envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentEnvelope"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "operationId": "putDocument",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/IfMatch" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentEnvelope" } } }
        },
        "responses": {
          "200": { "description": "Committed document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentSaveResponse" } } } },
          "409": { "$ref": "#/components/responses/Error" },
          "412": { "$ref": "#/components/responses/Error" },
          "428": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/reading-dictionary": {
      "get": {
        "operationId": "listReadingDictionary",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "Project reading dictionary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingDictionary" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createReadingDictionaryEntry",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DictionaryEntryInput" } } } },
        "responses": {
          "201": { "description": "Created dictionary entry", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DictionaryEntry" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/reading-dictionary/{entryId}": {
      "put": {
        "operationId": "updateReadingDictionaryEntry",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "name": "entryId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DictionaryEntryInput" } } } },
        "responses": { "200": { "description": "Updated dictionary entry", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DictionaryEntry" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "deleteReadingDictionaryEntry",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "name": "entryId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted dictionary entry" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/projects/{projectId}/lyrics": {
      "get": {
        "operationId": "getLyrics",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Revision" }
        ],
        "responses": {
          "200": { "description": "Committed TTML" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/imports": {
      "post": {
        "operationId": "importCandidate",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Revision" }
        ],
        "requestBody": { "required": true, "content": { "text/plain": {}, "application/ttml+xml": {} } },
        "responses": { "200": { "description": "Candidate import; never saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportCandidate" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/projects/{projectId}/audio": {
      "get": {
        "operationId": "getAudio",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "Playable audio" },
          "206": { "description": "Partial audio" },
          "416": { "description": "Range not satisfiable" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/waveform": {
      "get": {
        "operationId": "getWaveform",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Level" },
          { "$ref": "#/components/parameters/StartUs" },
          { "$ref": "#/components/parameters/EndUs" }
        ],
        "responses": {
          "200": {
            "description": "Waveform window",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WaveformWindow" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Level": {
        "name": "level",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0, "default": 8 }
      },
      "StartUs": {
        "name": "start_us",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 }
      },
      "EndUs": {
        "name": "end_us",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 }
      },
      "Revision": {
        "name": "revision",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": { "type": "string" }
      },
      "JobId": {
        "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Session expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": ["name", "source_asset_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source_asset_id": { "type": "string" }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "filename",
          "content_type",
          "size_bytes",
          "duration_us",
          "status",
          "asset_hash",
          "source_start_us",
          "proxy_offset_us"
        ],
        "properties": {
          "schema_version": { "const": "studio-asset-v1" },
          "id": { "type": "string" },
          "filename": { "type": "string" },
          "content_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "duration_us": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "type": "string", "enum": ["ready"] },
          "asset_hash": { "type": "string" },
          "source_start_us": { "type": "integer" },
          "proxy_offset_us": { "type": "integer" }
        }
      },
      "WaveformWindow": {
        "type": "object",
        "required": [
          "schema_version",
          "asset_id",
          "asset_hash",
          "version",
          "level",
          "start_us",
          "end_us",
          "bucket_us",
          "minimum",
          "maximum"
        ],
        "properties": {
          "schema_version": { "const": "studio-waveform-v1" },
          "asset_id": { "type": "string" },
          "asset_hash": { "type": "string" },
          "version": { "type": "string" },
          "level": { "type": "integer", "minimum": 0, "maximum": 15 },
          "start_us": { "type": "integer", "minimum": 0 },
          "end_us": { "type": "integer", "minimum": 0 },
          "bucket_us": { "type": "integer", "minimum": 1 },
          "minimum": {
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "maximum": {
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message", "request_id", "retryable"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["schema_version", "authenticated", "user"],
        "properties": {
          "schema_version": {
            "const": "studio-session-v1"
          },
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "type": ["object", "null"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["id", "name"]
          }
        }
      },
      "Capability": {
        "type": "object",
        "required": ["id", "enabled", "reason"],
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": ["string", "null"]
          },
          "experimental": {
            "type": "boolean"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": ["schema_version", "items"],
        "properties": {
          "schema_version": {
            "const": "studio-capabilities-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "name",
          "updated_at",
          "document_status"
        ],
        "properties": {
          "schema_version": {
            "const": "studio-project-v1"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "document_status": {
            "type": "string",
            "enum": ["empty", "draft", "ready"]
          },
          "asset": {
            "anyOf": [
              { "$ref": "#/components/schemas/Asset" },
              { "type": "null" }
            ]
          }
        }
      },
      "ProjectList": {
        "type": "object",
        "required": ["schema_version", "items", "next_cursor"],
        "properties": {
          "schema_version": {
            "const": "studio-project-list-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          },
          "next_cursor": {
            "type": ["string", "null"]
          }
        }
      },
      "JobParams": {
        "type": "object",
        "required": ["params"],
        "properties": { "params": { "type": "object", "additionalProperties": true } },
        "additionalProperties": false
      },
      "JobCreate": {
        "type": "object",
        "required": ["kind", "params"],
        "properties": {
            "kind": { "type": "string", "enum": ["search", "fetch", "transcribe", "align", "line_align", "reading", "forced_align"] },
          "params": {
            "type": "object",
            "required": ["revision", "asset_id"],
            "properties": {
              "revision": { "type": "string" },
              "asset_id": { "type": "string" },
              "line_ids": { "type": "array", "items": { "type": "string" } },
              "line_id": { "type": "string" },
              "input_granularity": { "type": "string", "enum": ["word", "mora", "phoneme"] },
              "language": { "type": ["string", "null"] },
              "coordinate_space": { "type": "string", "enum": ["text", "ruby"] },
              "ruby_id": { "type": "string" },
              "base_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
              "granularity": { "type": "string", "enum": ["word", "mora", "phoneme"] },
              "title": { "type": ["string", "null"] },
              "artist": { "type": ["string", "null"] },
              "album": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "JobEvent": {
        "type": "object",
        "required": ["schema_version", "job_id", "seq", "kind", "state_version"],
        "properties": {
          "schema_version": { "const": "studio-job-event-v1" }, "job_id": { "type": "string" },
          "seq": { "type": "integer", "minimum": 1 }, "kind": { "type": "string" },
          "stage": { "type": ["string", "null"] }, "completed": { "type": ["integer", "null"] },
          "total": { "type": ["integer", "null"] }, "message": { "type": ["string", "null"] },
          "state_version": { "type": "integer", "minimum": 0 }, "created_at": { "type": "string" }
        }
      },
      "JobResult": {
        "type": "object",
        "required": ["schema_version", "job_id", "binding"],
        "properties": {
          "schema_version": { "const": "studio-job-result-v1" }, "job_id": { "type": "string" },
          "binding": { "type": "object", "required": ["project_id", "asset_id", "revision"], "properties": {
            "project_id": { "type": "string" }, "asset_id": { "type": "string" }, "revision": { "type": "string" }, "revision_sha256": { "type": ["string", "null"] }
          } },
          "items": { "type": "array", "items": { "anyOf": [
            { "$ref": "#/components/schemas/SearchCandidate" },
            { "$ref": "#/components/schemas/FetchedLyric" },
            { "$ref": "#/components/schemas/AlignedLine" },
            { "$ref": "#/components/schemas/TranscriptionSegment" },
            { "$ref": "#/components/schemas/ReadingProposal" },
            { "$ref": "#/components/schemas/ForcedAlignmentUnit" }
          ] } }
          ,"proposals": { "type": "array", "items": { "$ref": "#/components/schemas/ReadingProposal" } },
          "units": { "type": "array", "items": { "$ref": "#/components/schemas/ForcedAlignmentUnit" } },
          "evidence": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      },
      "DictionaryEntryInput": {
        "type": "object",
        "required": ["surface", "reading"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "reading": { "type": "string", "minLength": 1 }
        }
      },
      "DictionaryEntry": {
        "allOf": [
          { "$ref": "#/components/schemas/DictionaryEntryInput" },
          { "type": "object", "required": ["schema_version", "project_id", "id", "updated_at"], "properties": {
            "schema_version": { "const": "studio-reading-dictionary-entry-v1" },
            "project_id": { "type": "string" }, "id": { "type": "string" }, "updated_at": { "type": "string", "format": "date-time" }
          } }
        ]
      },
      "ReadingDictionary": {
        "type": "object",
        "required": ["schema_version", "project_id", "items"],
        "properties": {
          "schema_version": { "const": "studio-reading-dictionary-v1" },
          "project_id": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/DictionaryEntry" } }
        }
      },
      "ReadingProposal": {
        "type": "object",
        "required": ["line_id", "proposal_id", "base_start", "base_end", "base", "reading", "source", "needs_review"],
        "properties": {
          "line_id": { "type": "string" }, "proposal_id": { "type": "string" },
          "base_start": { "type": "integer", "minimum": 0 }, "base_end": { "type": "integer", "minimum": 1 },
          "base": { "type": "string" }, "reading": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["dictionary", "sudachi"] }, "needs_review": { "type": "boolean" }
        }
      },
      "SearchCandidate": { "type": "object", "required": ["source", "candidate_id", "title", "match_score"], "properties": { "source": { "type": "string" }, "candidate_id": { "type": "string" }, "title": { "type": "string" }, "artist": { "type": ["string", "null"] }, "album": { "type": ["string", "null"] }, "duration": { "type": ["number", "null"] }, "match_score": { "type": "number" }, "raw": { "type": "object" } } },
      "FetchedLyric": { "type": "object", "required": ["candidate", "provider_rank", "line_count", "lines"], "properties": { "candidate": { "$ref": "#/components/schemas/SearchCandidate" }, "provider_rank": { "type": "integer" }, "line_count": { "type": "integer" }, "lines": { "type": "array", "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "start": { "type": ["number", "null"] }, "end": { "type": ["number", "null"] } } } } } },
      "AlignedLine": { "type": "object", "required": ["line_id", "timing_source"], "properties": { "line_id": { "type": "string" }, "start": { "type": ["number", "null"] }, "end": { "type": ["number", "null"] }, "begin_us": { "type": ["integer", "null"] }, "end_us": { "type": ["integer", "null"] }, "similarity": { "type": ["number", "null"] }, "score": { "type": ["number", "null"] }, "timing_source": { "type": "string" }, "source_segment_ids": { "type": "array", "items": { "type": "string" } }, "issues": { "type": "array", "items": { "type": "string" } } } },
      "ForcedAlignmentUnit": { "type": "object", "required": ["line_id", "input_range", "text", "start", "end", "start_us", "end_us", "granularity", "confidence"], "properties": { "line_id": { "type": "string" }, "input_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } }, "source_range": { "type": "array", "items": { "type": "integer" } }, "text": { "type": "string" }, "start": { "type": ["number", "null"] }, "end": { "type": ["number", "null"] }, "start_us": { "type": ["integer", "null"] }, "end_us": { "type": ["integer", "null"] }, "granularity": { "type": "string", "enum": ["subword", "word", "character", "mora", "phoneme"] }, "confidence": { "type": ["number", "null"] } } },
      "TranscriptionSegment": { "type": "object", "required": ["source_segment_id", "text"], "properties": { "source_segment_id": { "type": "string" }, "text": { "type": "string" }, "language": { "type": ["string", "null"] }, "start": { "type": ["number", "null"] }, "end": { "type": ["number", "null"] }, "begin_us": { "type": ["integer", "null"] }, "end_us": { "type": ["integer", "null"] }, "confidence": { "type": ["number", "null"] }, "timed_text": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": true },
      "Job": {
        "type": "object",
        "required": ["schema_version", "id", "project_id", "kind", "status", "request", "result_available", "state_version"],
        "properties": {
          "schema_version": { "const": "studio-job-v1" },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "project_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "interrupted",
              "cancelled"
            ]
          },
          "request": { "type": "object", "additionalProperties": true },
          "result_available": { "type": "boolean" },
          "error": { "type": ["object", "null"] },
          "engine": { "type": ["object", "null"] },
          "created_at": { "type": "string" }, "updated_at": { "type": "string" },
          "state_version": { "type": "integer", "minimum": 0 }
        }
      },
      "JobList": {
        "type": "object",
        "required": ["schema_version", "items"],
        "properties": {
          "schema_version": {
            "const": "studio-job-list-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "DocumentEnvelope": {
        "type": "object",
        "required": ["schema_version", "project_id", "revision", "document"],
        "properties": {
          "schema_version": { "const": "studio-document-v1" },
          "project_id": { "type": "string" },
          "revision": { "type": ["string", "null"] },
          "etag": { "type": "string" },
          "sha256": { "type": "string" },
          "client_seq": { "type": ["integer", "null"], "minimum": 0 },
          "document": {
            "type": "object",
            "required": ["schema_version", "ttml"],
            "properties": {
              "schema_version": { "const": "studio-document-content-v1" },
              "ttml": { "type": "string", "maxLength": 2097152 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "DocumentSaveResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/DocumentEnvelope" },
          { "type": "object", "required": ["saved"], "properties": {
            "saved": { "type": "object", "required": ["id", "etag", "sha256", "created_at"], "properties": {
              "id": { "type": "string" }, "etag": { "type": "string" }, "sha256": { "type": "string" }, "created_at": { "type": "string" }, "client_seq": { "type": ["integer", "null"] }
            } }
          } }
        ]
      },
      "ImportCandidate": {
        "type": "object", "required": ["schema_version", "project_id", "input_revision", "candidate", "diagnostics", "saved"],
        "properties": {
          "schema_version": { "const": "studio-import-v1" }, "project_id": { "type": "string" }, "input_revision": { "type": ["string", "null"] },
          "candidate": { "type": "object", "required": ["format"], "properties": { "format": { "enum": ["ttml", "lrc", "text"] }, "ttml": { "type": "string" }, "text": { "type": "string" }, "lines": { "type": "array", "items": { "type": "object", "required": ["begin_us", "text"], "properties": { "begin_us": { "type": ["integer", "null"] }, "text": { "type": "string" } } } } } },
          "diagnostics": { "type": "array", "items": { "type": "object" } }, "saved": { "const": false }
        }
      },
      "DocumentShell": {
        "type": "object",
        "required": [
          "schema_version",
          "project_id",
          "revision",
          "title",
          "language",
          "lines",
          "read_only_reasons"
        ],
        "properties": {
          "schema_version": {
            "const": "studio-document-shell-v1"
          },
          "project_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "begin_us", "end_us"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "begin_us": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "end_us": {
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              }
            }
          },
          "read_only_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
