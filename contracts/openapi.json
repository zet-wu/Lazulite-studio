{
  "openapi": "3.1.0",
  "info": {
    "title": "Lazulite Studio API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Available capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created project",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectSummary" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/assets": {
      "post": {
        "operationId": "uploadAsset",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded asset",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Project summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects/{projectId}/jobs": {
      "get": {
        "operationId": "listJobs",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects/{projectId}/document": {
      "get": {
        "operationId": "getDocument",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only document shell",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentShell"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects/{projectId}/lyrics": {
      "get": {
        "operationId": "getLyrics",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Revision" }
        ],
        "responses": {
          "200": { "description": "Committed TTML" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/audio": {
      "get": {
        "operationId": "getAudio",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": { "description": "Playable audio" },
          "206": { "description": "Partial audio" },
          "416": { "description": "Range not satisfiable" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{projectId}/waveform": {
      "get": {
        "operationId": "getWaveform",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Level" },
          { "$ref": "#/components/parameters/StartUs" },
          { "$ref": "#/components/parameters/EndUs" }
        ],
        "responses": {
          "200": {
            "description": "Waveform window",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WaveformWindow" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Level": {
        "name": "level",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0, "default": 8 }
      },
      "StartUs": {
        "name": "start_us",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 }
      },
      "EndUs": {
        "name": "end_us",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0 }
      },
      "Revision": {
        "name": "revision",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Session expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": ["name", "source_asset_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source_asset_id": { "type": "string" }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "filename",
          "content_type",
          "size_bytes",
          "duration_us",
          "status",
          "asset_hash",
          "source_start_us",
          "proxy_offset_us"
        ],
        "properties": {
          "schema_version": { "const": "studio-asset-v1" },
          "id": { "type": "string" },
          "filename": { "type": "string" },
          "content_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "duration_us": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "type": "string", "enum": ["ready"] },
          "asset_hash": { "type": "string" },
          "source_start_us": { "type": "integer" },
          "proxy_offset_us": { "type": "integer" }
        }
      },
      "WaveformWindow": {
        "type": "object",
        "required": [
          "schema_version",
          "asset_id",
          "asset_hash",
          "version",
          "level",
          "start_us",
          "end_us",
          "bucket_us",
          "minimum",
          "maximum"
        ],
        "properties": {
          "schema_version": { "const": "studio-waveform-v1" },
          "asset_id": { "type": "string" },
          "asset_hash": { "type": "string" },
          "version": { "type": "string" },
          "level": { "type": "integer", "minimum": 0, "maximum": 15 },
          "start_us": { "type": "integer", "minimum": 0 },
          "end_us": { "type": "integer", "minimum": 0 },
          "bucket_us": { "type": "integer", "minimum": 1 },
          "minimum": {
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "maximum": {
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message", "request_id", "retryable"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["schema_version", "authenticated", "user"],
        "properties": {
          "schema_version": {
            "const": "studio-session-v1"
          },
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "type": ["object", "null"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["id", "name"]
          }
        }
      },
      "Capability": {
        "type": "object",
        "required": ["id", "enabled", "reason"],
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": ["string", "null"]
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": ["schema_version", "items"],
        "properties": {
          "schema_version": {
            "const": "studio-capabilities-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "name",
          "updated_at",
          "document_status"
        ],
        "properties": {
          "schema_version": {
            "const": "studio-project-v1"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "document_status": {
            "type": "string",
            "enum": ["empty", "draft", "ready"]
          },
          "asset": {
            "anyOf": [
              { "$ref": "#/components/schemas/Asset" },
              { "type": "null" }
            ]
          }
        }
      },
      "ProjectList": {
        "type": "object",
        "required": ["schema_version", "items", "next_cursor"],
        "properties": {
          "schema_version": {
            "const": "studio-project-list-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          },
          "next_cursor": {
            "type": ["string", "null"]
          }
        }
      },
      "Job": {
        "type": "object",
        "required": ["id", "kind", "status", "stage", "completed", "total"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "interrupted",
              "cancelled"
            ]
          },
          "stage": {
            "type": ["string", "null"]
          },
          "completed": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "total": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      },
      "JobList": {
        "type": "object",
        "required": ["schema_version", "items"],
        "properties": {
          "schema_version": {
            "const": "studio-job-list-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "DocumentShell": {
        "type": "object",
        "required": [
          "schema_version",
          "project_id",
          "revision",
          "title",
          "language",
          "lines",
          "read_only_reasons"
        ],
        "properties": {
          "schema_version": {
            "const": "studio-document-shell-v1"
          },
          "project_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "begin_us", "end_us"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "begin_us": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "end_us": {
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              }
            }
          },
          "read_only_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
