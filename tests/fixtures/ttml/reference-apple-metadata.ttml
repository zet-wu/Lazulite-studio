<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xml:lang="ja">
    <head>
        <metadata>
            <ttm:agent xml:id="v1">
                <ttm:name>A</ttm:name>
            </ttm:agent>
            <ttm:agent xml:id="v2">
                <ttm:name>B</ttm:name>
            </ttm:agent>
            <amll:meta key="musicName" value="自作サンプル"/>
            <amll:meta key="artists" value="Test"/>
            <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
                <translations>
                    <translation xml:lang="zh">
                        <text for="L1">今天 也唱歌</text>
                    </translation>
                </translations>
                <transliterations>
                    <transliteration xml:lang="ja-Latn">
                        <text for="L1">kyou mo utau</text>
                    </transliteration>
                </transliterations>
                <songwriters>
                    <songwriter>Composer</songwriter>
                </songwriters>
            </iTunesMetadata>
        </metadata>
    </head>
    <body dur="4.000">
        <div begin="1.000" end="4.000" itunes:songPart="Verse">
            <p begin="1.000" end="3.000" itunes:key="L1" ttm:agent="v1">
                <span tts:ruby="container">
                    <span tts:ruby="base">今日</span>
                    <span tts:ruby="textContainer">
                        <span tts:ruby="text" begin="1.000" end="1.500">きょ</span>
                        <span tts:ruby="text" begin="1.500" end="2.000">う</span>
                    </span>
                </span>
                <span begin="2.000" end="3.000"> も歌う</span>
                <span ttm:role="x-bg">
                    <span begin="1.500" end="2.700">(響く)</span>
                </span>
            </p>
            <p begin="3.000" end="4.000" itunes:key="L2" ttm:agent="v2">
                <span tts:ruby="container">
                    <span tts:ruby="base">宇宙</span>
                    <span tts:ruby="textContainer">
                        <span tts:ruby="text" begin="3.000" end="4.000">そら</span>
                    </span>
                </span>
            </p>
        </div>
    </body>
</tt>
