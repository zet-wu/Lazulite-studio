{
  "name": "@lazulite-studio/frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_ENABLE_MOCKS=true vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:generate": "openapi-typescript ../contracts/openapi.json -o src/adapters/http/generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.85.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/node": "22.18.0",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "msw": "2.11.1",
    "openapi-typescript": "7.9.1",
    "cross-env": "10.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
